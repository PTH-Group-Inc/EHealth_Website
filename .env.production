# ============================================
# PRODUCTION environment (tự động load khi `npm run build` + `npm start`)
# ============================================

# Backend API — EMPTY = same-origin.
# Browser sẽ gọi /api/... (HTTPS cùng FE domain). Next.js rewrites (next.config.mjs)
# server-side proxy sang BE thật BACKEND_ORIGIN.
NEXT_PUBLIC_API_URL=https://dev.thanhhaishopwebsite.id.vn

# BE origin thật (chỉ Next.js server đọc — không lộ ra browser)
BACKEND_ORIGIN=

# Site URL cho metadata/OG tags
NEXT_PUBLIC_SITE_URL=https://dev.thanhhaishopwebsite.id.vn

# App Environment
NEXT_PUBLIC_ENV=production
