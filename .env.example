# ============================================
# E-Health Frontend — Environment Variables
# ============================================
#
# 👉 KHÔNG CẦN tạo .env.local nếu bạn chỉ chạy `npm run dev`.
#    Next.js sẽ tự load .env.development (đã commit, trỏ BE test server)
#    → bạn có data thật ngay lập tức.
#
# 👉 CHỈ tạo .env.local khi bạn muốn override (VD: chạy BE local).
#    .env.local đã được .gitignore → không ảnh hưởng team.
# ============================================

# ----- Backend API -----
# Các option có sẵn:
#   http://160.250.186.97:3000         # BE test server team (default .env.development)
#   https://dev.thanhhaishopwebsite.id.vn  # BE production (default .env.production)
#   http://localhost:3000               # BE local của bạn (cd /Users/minhquan/EH/EHealth-Api && npm run dev)
NEXT_PUBLIC_API_URL=http://160.250.186.97:3000

# ----- Site URL (metadata / OG tags) -----
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ----- WebSocket (real-time: telemedicine, notifications) -----
# NEXT_PUBLIC_WS_URL=ws://160.250.186.97:3000

# ----- Google OAuth (nếu dùng đăng nhập Google) -----
# Lấy tại https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# ----- App Environment -----
# development | staging | production
NEXT_PUBLIC_ENV=development

# ============================================
# Tài khoản test có sẵn trên BE test server:
#   admin@ehealth.vn    — role ADMIN
#   doctor@ehealth.vn   — role DOCTOR
#   (mật khẩu xem tài liệu nội bộ team)
# ============================================
